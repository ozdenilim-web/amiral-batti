{
  "rules": {
    "profiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "elo": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000" },
        "gold": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999" },
        "wins": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "losses": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "totalGames": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "displayName": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 16" }
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null && (auth.uid === data.child('p1_uid').val() || auth.uid === data.child('p2_uid').val() || !data.child('p2_uid').val())",
        ".write": "auth != null && ((!data.exists() && (newData.child('p1_uid').val() === auth.uid || newData.child('p2_uid').val() === auth.uid)) || (data.exists() && !newData.exists() && (auth.uid === data.child('p1_uid').val() || auth.uid === data.child('p2_uid').val())))",
        "p2_uid": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "p2_name": {
          ".write": "auth != null && !data.exists() && newData.parent().child('p2_uid').val() === auth.uid"
        },
        "phase": {
          ".write": "auth != null && (auth.uid === newData.parent().child('p1_uid').val() || auth.uid === newData.parent().child('p2_uid').val())"
        },
        "turn": {
          ".write": "auth != null && (auth.uid === newData.parent().child('p1_uid').val() || auth.uid === newData.parent().child('p2_uid').val())"
        },
        "clocks": {
          ".write": "auth != null && (auth.uid === newData.parent().child('p1_uid').val() || auth.uid === newData.parent().child('p2_uid').val())"
        },
        "attacks": {
          ".write": "auth != null && (auth.uid === newData.parent().child('p1_uid').val() || auth.uid === newData.parent().child('p2_uid').val())"
        },
        "p1_board": {
          ".write": "auth != null && auth.uid === data.parent().child('p1_uid').val() && data.val() === null"
        },
        "p2_board": {
          ".write": "auth != null && auth.uid === data.parent().child('p2_uid').val() && data.val() === null"
        },
        "p1_ships": {
          ".write": "auth != null && auth.uid === data.parent().child('p1_uid').val() && data.val() === null"
        },
        "p2_ships": {
          ".write": "auth != null && auth.uid === data.parent().child('p2_uid').val() && data.val() === null"
        },
        "salvo_p1": {
          ".write": "auth != null && auth.uid === data.parent().child('p1_uid').val() && data.val() === null"
        },
        "salvo_p2": {
          ".write": "auth != null && auth.uid === data.parent().child('p2_uid').val() && data.val() === null"
        },
        "salvoResult": {
          ".write": "auth != null && data.val() === null && (auth.uid === data.parent().child('p1_uid').val() || auth.uid === data.parent().child('p2_uid').val())"
        },
        "winner": {
          ".write": "auth != null && data.val() === null && (auth.uid === newData.parent().child('p1_uid').val() || auth.uid === newData.parent().child('p2_uid').val())"
        },
        "winReason": {
          ".write": "auth != null && (auth.uid === newData.parent().child('p1_uid').val() || auth.uid === newData.parent().child('p2_uid').val())"
        },
        "eloProcessed": {
          ".write": "auth != null && data.val() !== true && (auth.uid === newData.parent().child('p1_uid').val() || auth.uid === newData.parent().child('p2_uid').val())"
        }
      }
    },
    "global_stats": {
      ".read": true,
      ".write": "auth != null"
    },
    "online_players": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "matchmaking": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || !data.exists())"
      }
    },
    "matchmaking_claims": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || !data.exists() || data.child('by').val() === auth.uid || newData.child('t').val() >= data.child('t').val() + 15000)"
      }
    },
    "matchmaking_arena": {
      ".read": "auth != null",
      "$arenaId": {
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || !data.exists())"
        }
      }
    },
    "match_found": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    "invites": {
      "$targetUid": {
        "$fromUid": {
          ".read": "auth != null && (auth.uid === $targetUid || auth.uid === $fromUid)",
          ".write": "auth != null && (auth.uid === $targetUid || auth.uid === $fromUid)"
        }
      }
    },
    "emojis": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "siege_rooms": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null"
      }
    }
  }
}
